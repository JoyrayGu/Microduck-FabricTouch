{
  "_说明": "python run.py --config config.example.json --gui 即可加载；界面/命令行调整后会覆盖这里的值。默认走 USB 通道，改用蓝牙请把 transport_kind 改成 \"ble\"。",
  "transport_kind": "usb",
  "auto_calibrate_on_start": false,
  "usb": {
    "_说明": "port 留空=自动选择 USB 虚拟串口；baudrate 为 0=自动试探（文档未给出波特率）。",
    "port": null,
    "port_hint": null,
    "baudrate": 9600,
    "format": "auto",
    "ascii_scale": 100.0,
    "ascii_timeout": 0.5,
    "allow_partial": false,
    "read_timeout": 0.05,
    "reconnect": true,
    "autobaud": true,
    "dtr": true,
    "exclusive": true
  },
  "filter": {
    "rows": 32,
    "cols": 32,
    "spatial_smooth_passes": 0,
    "ema_alpha": 0.5,
    "baseline_frames": 40,
    "use_baseline": true,
    "activate_abs": 300.0,
    "activate_rel": 0.12,
    "min_active_cells": 2,
    "min_contact_cells": 2,
    "merge_radius_cells": 1.6,
    "max_contacts": 3
  },
  "gesture": {
    "tap_max_ms": 260.0,
    "double_tap_ms": 420.0,
    "long_press_ms": 650.0,
    "tap_move_tol": 0.85,
    "heavy_total": 7000.0,
    "heavy_settle_ms": 200.0,
    "heavy_auto": true,
    "heavy_auto_ratio": 1.7,
    "scroll_axis_ratio": 0.8,
    "scroll_deadzone": 0.35,
    "double_click_as_event": false
  },
  "mapping": {
    "_说明": "mode 可选: joystick / absolute / ninegrid。ninegrid 模式会在上下左右边缘移动时发出 move_up / move_down / move_left / move_right 事件，日志和 GUI 会显示这些事件。",
    "mode": "ninegrid",
    "origin": "touch",
    "touch_range_cells": 2.2,
    "edge_recenter": false,
    "edge_recenter_cells_s": 1.6,
    "max_speed_px_s": 780.0,
    "deadzone": 0.13,
    "gamma": 1.7,
    "speed_smoothing": 0.45,
    "pressure_speed_mix": 0.35,
    "pressure_ref": 0.0,
    "invert_x": false,
    "invert_y": false,
    "abs_margin_px": 6,
    "max_step_px": 220.0,
    "scroll_gain": 1.0,
    "scroll_invert": false
  },
  "device_threshold": 10,
  "device_array": [32, 32],
  "device_mode": 0,
  "acquire": "continuous",
  "single_poll_hz": 30.0,
  "invert_grid_x": false,
  "invert_grid_y": false,
  "robot_gesture": {
    "_说明": "机器人手势识别参数（独立于鼠标手势）。只把压力场识别成 tap / single_stroke / back_forth_stroke，动作语义由 brain 端决定。",
    "tap_move_tol": 0.9,
    "tap_max_ms": 320.0,
    "stroke_min_path": 3.0,
    "stroke_min_net": 2.0,
    "stroke_max_step": 6.0,
    "stroke_pause_tol": 0.15,
    "stroke_pause_break_ms": 400.0,
    "reversal_min_disp": 1.2,
    "direction_dominance": 0.6,
    "stroke_min_ms": 120.0
  },
  "robot_link": {
    "_说明": "python run.py --robot 时发往 brain（RK3566）的网络参数；也可用 --brain-host/--brain-port 覆盖。",
    "host": "192.168.1.50",
    "port": 9000,
    "connect_timeout": 3.0,
    "timeout": 2.0,
    "reconnect": true,
    "reconnect_interval": 1.0,
    "queue_size": 64
  }
}

