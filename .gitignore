# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
ENV/

# --- Test / type-check caches ---
.pytest_cache/
.mypy_cache/
.dmypy.json
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# --- Doxygen build output ---
skin/docs/html/
skin/docs/latex/

